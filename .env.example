# Google Maps Platform API key (used for the Map3DElement 3D buildings engine).
# Get one at https://console.cloud.google.com/google/maps-apis/credentials — requires a
# Cloud Billing account. Restrict it (HTTP referrers) to your own domain(s) once you have one.
VITE_GOOGLE_MAPS_API_KEY=

# A vector Map ID (Google Maps Platform → Map Management) with a published
# style attached that hides the default Points of interest / Transit
# layers — without it the base map shows Google's own restaurant/shop/
# hospital icons everywhere, cluttering the map alongside our own markers.
# Optional: the map still works without one, just with those icons visible.
VITE_GOOGLE_MAPS_MAP_ID=

# Mapbox access token (used by the parallel Mapbox-based map — a separate,
# experimental map engine kept alongside the Google 3D map, not a
# replacement for it). Get one at https://account.mapbox.com/access-tokens/.
VITE_MAPBOX_ACCESS_TOKEN=

# Server-only (no VITE_ prefix — never sent to the browser). Used by
# server/routes/branding.ts to look up a campaign's client's own website
# domain by name, so their real logo (via Clearbit's public logo endpoint)
# can be shown next to their campaign instead of nothing. Get a key at
# https://aistudio.google.com/apikey. Optional: without it, client logos
# just fall back to an initials badge.
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-2.5-flash

# Server-only. Used by server/routes/propertyImages.ts to show real photos
# in a property's inspector panel — a plain Google Images search on
# "<property name>, <locality>", since the source sheet's own Drive photo
# links require sign-in. Google's own Custom Search JSON API is closed to
# new Cloud projects (confirmed by testing — not fixable by enabling
# anything), so this uses Serper.dev instead: sign up free at
# https://serper.dev (email only, no Cloud project/billing needed), copy
# the API key from its dashboard. Free tier: 2,500 searches, no card
# required. Optional: without it set, the photo strip just doesn't render.
SERPER_API_KEY=

# Backend API (server/) — the shared password sales reps use to log in and
# upload a campaign shortlist, and the secret used to sign session cookies.
SALES_LOGIN_PASSWORD=
SESSION_SECRET=
# Port the API server listens on (the Vite dev server proxies /api to it).
PORT=4000
