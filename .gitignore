# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
dist-server
*.local

# SQLite database for campaign uploads (server/db.ts)
server/data/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Video build intermediates (video/README.md). The finished demo.mp4, its
# poster and the generated chapter list are tracked; the raw captures are
# not — they are ~8 MB of PNGs that capture.mjs regenerates on demand.
video/shots/
# The raw screen recording plus its step marks. Kept locally so narration can
# be swapped and re-muxed without re-recording (see video/README.md), but far
# too large to track.
video/.rec/
video/narration/_line.txt
# Every raw TTS take narrate.mjs downloaded (PACE_ONLY=1 re-paces from these
# without calling the API again). Useful locally, not worth 6 MB in history.
video/narration/takes/
video/.tmp-graphics/

# Audit screenshots (video/audit.mjs) — regenerable, review-only.
video/audit/
